<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - FastDate.in | Account Recovery</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            lime: {
              300: '#bef264',
              400: '#a3e635',
              450: '#9ef01a',
              500: '#84cc16',
              600: '#65a30d',
              50: '#f7fee7'
            }
          },
          boxShadow: {
            'glow-lime': '0 0 30px -5px rgba(163, 230, 53, 0.4)',
          }
        }
      }
    }
  </script>

  <style>
    .wave-bg {
      background: radial-gradient(circle at 50% -20%, #bef264 0%, #a3e635 45%, #84cc16 85%, #65a30d 100%);
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">
  <!-- Main Recovery Card Container -->
  <main class="flex-1 flex items-center justify-center p-0 md:p-6">
    <div class="w-full max-w-[430px] bg-white md:rounded-[40px] md:shadow-2xl overflow-hidden md:border md:border-slate-200/80 min-h-screen md:min-h-[760px] flex flex-col justify-between relative">
      
      <!-- Top Organic Wave Header with Back Arrow -->
      <div class="relative w-full h-40 wave-bg shadow-sm flex flex-col justify-between pt-6 pb-6 px-6 overflow-hidden select-none">
        
        <!-- Subtle Wave Contours -->
        <svg class="absolute inset-0 w-full h-full opacity-20 pointer-events-none" viewBox="0 0 400 160" fill="none" stroke="#ffffff" stroke-width="1.6">
          <path d="M-20 30 Q 100 100, 220 30 T 420 70" />
          <path d="M-40 70 Q 90 140, 240 60 T 440 100" />
        </svg>

        <!-- Top Back Nav -->
        <div class="relative z-10 flex items-center justify-between">
          <a href="login.html" class="w-9 h-9 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow-sm transition-transform active:scale-90">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
          </a>
          <span class="text-[11px] font-bold text-slate-950 bg-white/30 backdrop-blur-md px-3 py-1 rounded-full">
            ACCOUNT SECURITY
          </span>
        </div>

        <!-- Title & Subtitle -->
        <div class="relative z-10">
          <h1 class="text-xl font-extrabold text-slate-950 tracking-tight">Reset Password</h1>
          <p class="text-xs font-semibold text-slate-900/80">Recover your FastDate account</p>
        </div>
      </div>

      <!-- Recovery Form Body -->
      <div class="px-7 py-6 -mt-4 bg-white rounded-t-[32px] flex-1 flex flex-col justify-between relative z-20">
        
        <div class="space-y-4">
          
          <!-- Security Shield Info -->
          <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-lime-400/20 text-lime-700 flex items-center justify-center text-lg flex-shrink-0 font-bold">
              🛡️
            </div>
            <div>
              <h4 class="text-xs font-bold text-slate-900">Encrypted Verification</h4>
              <p class="text-[11px] text-slate-500 leading-tight mt-0.5">
                We'll verify your phone or email to ensure only you can access your profile.
              </p>
            </div>
          </div>

          <!-- STEP 1: Phone or Email Input -->
          <div id="stepContact" class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">Registered Phone or Email</label>
              <div class="flex items-center border border-slate-200 rounded-2xl p-1.5 bg-slate-50/70 focus-within:bg-white focus-within:border-lime-500 focus-within:ring-2 focus-within:ring-lime-400/20 transition-all">
                <span class="px-3 text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
                </span>
                <input type="text" id="recoveryContact" value="+91 98201 45982" placeholder="e.g. 98201 45982 or email@gmail.com" class="w-full px-2 py-2 text-sm font-semibold text-slate-900 bg-transparent outline-none">
              </div>
            </div>

            <button onclick="goToOtpStep()" class="w-full py-4 rounded-2xl bg-lime-400 hover:bg-lime-500 text-slate-950 font-bold text-sm shadow-md shadow-lime-400/30 transition-all active:scale-[0.98]">
              Send Recovery Code
            </button>
          </div>

          <!-- STEP 2: 4-Digit OTP Code (Initially active in demo) -->
          <div id="stepOtp" class="space-y-4 pt-1">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-slate-700">Enter 4-digit code sent to +91 98201...</span>
              <span class="text-lime-600 font-bold cursor-pointer hover:underline" id="resendCode">Resend (42s)</span>
            </div>

            <div class="grid grid-cols-4 gap-3">
              <input type="text" maxlength="1" value="7" class="h-12 text-center text-lg font-bold rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-lime-500 outline-none">
              <input type="text" maxlength="1" value="1" class="h-12 text-center text-lg font-bold rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-lime-500 outline-none">
              <input type="text" maxlength="1" value="9" class="h-12 text-center text-lg font-bold rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-lime-500 outline-none">
              <input type="text" maxlength="1" value="4" class="h-12 text-center text-lg font-bold rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-lime-500 outline-none">
            </div>

            <!-- STEP 3: New Password Setup -->
            <div class="space-y-3 pt-2">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">New Password</label>
                <input type="password" placeholder="At least 8 characters" value="FastSpark2026@" class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-sm font-semibold text-slate-900 bg-slate-50 outline-none focus:bg-white focus:border-lime-500 focus:ring-2 focus:ring-lime-400/20">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Confirm New Password</label>
                <input type="password" placeholder="Re-enter password" value="FastSpark2026@" class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-sm font-semibold text-slate-900 bg-slate-50 outline-none focus:bg-white focus:border-lime-500 focus:ring-2 focus:ring-lime-400/20">
              </div>

              <!-- Password Strength Meter -->
              <div class="space-y-1">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="text-slate-500 font-semibold">Password Strength:</span>
                  <span class="text-emerald-600 font-bold">Strong</span>
                </div>
                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden flex gap-1">
                  <div class="w-1/3 bg-lime-400 rounded-full"></div>
                  <div class="w-1/3 bg-lime-500 rounded-full"></div>
                  <div class="w-1/3 bg-emerald-500 rounded-full"></div>
                </div>
              </div>
            </div>

            <!-- Final Reset Submit -->
            <button onclick="handlePasswordReset()" class="w-full py-4 rounded-2xl bg-lime-400 hover:bg-lime-500 text-slate-950 font-bold text-sm shadow-md shadow-lime-400/30 transition-all active:scale-[0.98]">
              Update Password & Log In
            </button>
          </div>

        </div>

        <!-- Bottom Links -->
        <div class="pt-6 text-center space-y-2">
          <p class="text-xs text-slate-500">
            Remembered your credentials? 
            <a href="login.html" class="text-slate-950 font-bold underline hover:text-lime-600 transition-colors">
              Back to Login
            </a>
          </p>
          <p class="text-[11px] text-slate-400">
            Need help? Contact <a href="#" class="text-slate-600 font-bold underline">FastDate Support</a>
          </p>
        </div>

      </div>

    </div>
  </main>

  <!-- Success Notification Toast (Hidden initially) -->
  <div id="successToast" class="fixed bottom-6 inset-x-4 max-w-sm mx-auto bg-slate-950 text-white border border-lime-400 p-4 rounded-2xl shadow-glow-lime hidden transition-all">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-lime-400 text-slate-950 font-black flex items-center justify-center text-sm">
        ✓
      </div>
      <div>
        <h5 class="text-xs font-bold text-white">Password Updated!</h5>
        <p class="text-[11px] text-slate-300">Redirecting you to login...</p>
      </div>
    </div>
  </div>
  <script>
    function goToOtpStep() {
      // Smooth visual feedback
      alert("Verification OTP sent to " + document.getElementById('recoveryContact').value);
    }

    function handlePasswordReset() {
      const toast = document.getElementById('successToast');
      toast.classList.remove('hidden');
      setTimeout(() => {
        window.location.href = 'login.html';
      }, 1500);
    }
  </script>
</body>
</html>
