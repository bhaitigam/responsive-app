<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - FastDate.in | Instant 3-Minute Dating</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            lime: {
              300: '#bef264',
              400: '#a3e635',
              450: '#9ef01a',
              500: '#84cc16',
              600: '#65a30d',
              50: '#f7fee7'
            }
          },
          boxShadow: {
            'glow-lime': '0 0 30px -5px rgba(163, 230, 53, 0.4)',
          }
        }
      }
    }
  </script>

  <style>
    /* Contour map watermark pattern */
    .contour-pattern {
      background-image: radial-gradient(rgba(163, 230, 53, 0.15) 1.5px, transparent 1.5px),
                        radial-gradient(rgba(148, 163, 184, 0.12) 1.5px, transparent 1.5px);
      background-size: 30px 30px;
      background-position: 0 0, 15px 15px;
    }
    .wave-bg {
      background: radial-gradient(circle at 50% -20%, #bef264 0%, #a3e635 45%, #84cc16 85%, #65a30d 100%);
    }
  </style>
</head>
<body class="bg-slate-100 md:bg-slate-900-bak text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">
  <!-- Main Login Card Container -->
  <main class="flex-1 flex items-center justify-center p-0 md:p-6">
    <div class="w-full max-w-[430px] bg-white md:rounded-[40px] md:shadow-2xl overflow-hidden md:border md:border-slate-200/80 min-h-screen md:min-h-[760px] flex flex-col justify-between relative">
      
      <!-- Top Organic Lime Wave Header (Arimo reference inspired) -->
      <div class="relative w-full h-44 wave-bg shadow-sm flex flex-col items-center justify-start pt-10 px-6 overflow-hidden select-none">
        
        <!-- Abstract Contour Lines -->
        <svg class="absolute inset-0 w-full h-full opacity-20 pointer-events-none" viewBox="0 0 400 200" fill="none" stroke="#ffffff" stroke-width="1.6">
          <path d="M-20 40 Q 100 120, 220 30 T 420 80" />
          <path d="M-40 90 Q 90 170, 240 70 T 440 120" />
          <path d="M-10 140 Q 120 200, 280 110 T 460 160" />
        </svg>

        <!-- Top pill -->
        <div class="relative z-10 flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/30 backdrop-blur-md text-slate-950 text-[11px] font-bold">
          <span>⚡ INDIA'S 3-MINUTE SPEED DATING</span>
        </div>

        <h1 class="relative z-10 text-2xl font-extrabold text-slate-950 mt-2 tracking-tight">
          Welcome to FastDate
        </h1>
        <p class="relative z-10 text-xs font-semibold text-slate-900/80">Login to your account</p>
      </div>

      <!-- Form Content Section -->
      <div class="px-7 py-6 -mt-6 bg-white rounded-t-[36px] flex-1 flex flex-col justify-between relative z-20">
        
        <div>
          <!-- Tab Switcher: Phone OTP vs Email & Password -->
          <div class="flex bg-slate-100 p-1 rounded-2xl mb-5 text-xs font-bold text-slate-600">
            <button id="tabPhone" onclick="toggleAuthMode('phone')" class="flex-1 py-2 rounded-xl bg-white text-slate-900 shadow-sm transition-all">
              Phone & OTP
            </button>
            <button id="tabEmail" onclick="toggleAuthMode('email')" class="flex-1 py-2 rounded-xl text-slate-500 hover:text-slate-900 transition-all">
              Email & Password
            </button>
          </div>

          <!-- MODE 1: PHONE NUMBER AUTHENTICATION (DEFAULT) -->
          <div id="phoneAuthForm" class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">Phone number</label>
              <div class="flex items-center border border-slate-200 rounded-2xl p-1.5 bg-slate-50/70 focus-within:bg-white focus-within:border-lime-500 focus-within:ring-2 focus-within:ring-lime-400/20 transition-all">
                <!-- Country Dropdown -->
                <div class="flex items-center gap-1.5 px-3 py-2 border-r border-slate-200 cursor-pointer select-none">
                  <span class="text-base leading-none">🇮🇳</span>
                  <span class="text-xs font-bold text-slate-800">+91</span>
                  <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <!-- Phone input -->
                <input type="tel" id="loginPhone" placeholder="Enter 10-digit number" value="98201 45982" class="w-full px-3 py-2 text-sm font-semibold text-slate-900 bg-transparent outline-none">
              </div>
              <p class="text-[11px] text-slate-400 mt-1.5 pl-1 leading-relaxed">
                We'll send an SMS or WhatsApp OTP to verify you. Standard rates apply.
              </p>
            </div>

            <!-- OTP Input Box (Hidden initially, simulates flow) -->
            <div id="otpBox" class="hidden space-y-2 pt-2">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-slate-700">Enter 4-digit OTP</span>
                <span id="resendTimer" class="text-lime-600 font-bold">Resend in 28s</span>
              </div>
              <div class="grid grid-cols-4 gap-3">
                <input type="text" maxlength="1" value="4" class="h-12 text-center text-lg font-bold rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-lime-500 outline-none">
                <input type="text" maxlength="1" value="8" class="h-12 text-center text-lg font-bold rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-lime-500 outline-none">
                <input type="text" maxlength="1" value="2" class="h-12 text-center text-lg font-bold rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-lime-500 outline-none">
                <input type="text" maxlength="1" value="9" class="h-12 text-center text-lg font-bold rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-lime-500 outline-none">
              </div>
            </div>

            <!-- Submit Button -->
            <button id="phoneSubmitBtn" onclick="handlePhoneContinue()" class="w-full py-4 rounded-2xl bg-lime-400 hover:bg-lime-500 text-slate-950 font-bold text-sm shadow-md shadow-lime-400/30 transition-all active:scale-[0.98]">
              Continue
            </button>
          </div>

          <!-- MODE 2: EMAIL & PASSWORD AUTHENTICATION -->
          <div id="emailAuthForm" class="hidden space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">Email address</label>
              <input type="email" placeholder="you@fastdate.in" value="aarav.sharma@fastdate.in" class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-slate-50/70 text-sm font-semibold text-slate-900 outline-none focus:bg-white focus:border-lime-500 focus:ring-2 focus:ring-lime-400/20">
            </div>

            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-xs font-bold text-slate-700">Password</label>
                <a href="forgot-password.html" class="text-xs font-bold text-slate-600 hover:text-lime-600 transition-colors">
                  Forgot password?
                </a>
              </div>
              <div class="relative">
                <input type="password" id="loginPassword" value="••••••••••••" class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-slate-50/70 text-sm font-semibold text-slate-900 outline-none focus:bg-white focus:border-lime-500 focus:ring-2 focus:ring-lime-400/20">
                <button type="button" onclick="togglePasswordVisibility()" class="absolute right-4 top-3 text-slate-400 hover:text-slate-600">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                </button>
              </div>
            </div>

            <div class="flex items-center justify-between text-xs">
              <label class="flex items-center gap-2 cursor-pointer text-slate-600">
                <input type="checkbox" checked class="rounded text-lime-500 focus:ring-lime-400 h-4 w-4">
                <span>Remember me for 30 days</span>
              </label>
            </div>

            <!-- Email Submit Button -->
            <button onclick="window.location.href='index.html'" class="w-full py-4 rounded-2xl bg-lime-400 hover:bg-lime-500 text-slate-950 font-bold text-sm shadow-md shadow-lime-400/30 transition-all active:scale-[0.98]">
              Log In
            </button>
          </div>

          <!-- Divider -->
          <div class="relative flex py-5 items-center">
            <div class="flex-grow border-t border-slate-200"></div>
            <span class="flex-shrink mx-3 text-xs text-slate-400 uppercase tracking-wider font-bold">Or</span>
            <div class="flex-grow border-t border-slate-200"></div>
          </div>

          <!-- Social Logins (Google & Apple) -->
          <div class="space-y-3">
            <!-- Google Button -->
            <button class="w-full py-3.5 px-4 rounded-2xl border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center justify-center gap-3 transition-colors shadow-sm">
              <svg class="w-4 h-4" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              Continue with Google
            </button>

            <!-- Apple Button -->
            <button class="w-full py-3.5 px-4 rounded-2xl border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-900 font-bold text-xs flex items-center justify-center gap-3 transition-colors shadow-sm">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-1 .04-2.13.67-2.75 1.41-.54.63-.99 1.68-.89 2.69 1.1.09 2.03-.49 2.63-1.23z"/>
              </svg>
              Continue with Apple
            </button>
          </div>
        </div>

        <!-- Bottom Signup Prompt -->
        <div class="pt-6 text-center">
          <p class="text-xs text-slate-500">
            Don't have an account? 
            <a href="register.html" class="text-slate-950 font-bold underline hover:text-lime-600 transition-colors">
              Create an account
            </a>
          </p>
        </div>

      </div>

    </div>
  </main>


  <!-- Script for Tab Switching & OTP simulation -->
  <script>
    function toggleAuthMode(mode) {
      const tabPhone = document.getElementById('tabPhone');
      const tabEmail = document.getElementById('tabEmail');
      const phoneForm = document.getElementById('phoneAuthForm');
      const emailForm = document.getElementById('emailAuthForm');

      if (mode === 'phone') {
        tabPhone.className = "flex-1 py-2 rounded-xl bg-white text-slate-900 shadow-sm transition-all";
        tabEmail.className = "flex-1 py-2 rounded-xl text-slate-500 hover:text-slate-900 transition-all";
        phoneForm.classList.remove('hidden');
        emailForm.classList.add('hidden');
      } else {
        tabEmail.className = "flex-1 py-2 rounded-xl bg-white text-slate-900 shadow-sm transition-all";
        tabPhone.className = "flex-1 py-2 rounded-xl text-slate-500 hover:text-slate-900 transition-all";
        emailForm.classList.remove('hidden');
        phoneForm.classList.add('hidden');
      }
    }

    let otpRevealed = false;
    function handlePhoneContinue() {
      if (!otpRevealed) {
        document.getElementById('otpBox').classList.remove('hidden');
        document.getElementById('phoneSubmitBtn').innerText = "Verify OTP & Enter";
        otpRevealed = true;
      } else {
        window.location.href = "index.html";
      }
    }

    function togglePasswordVisibility() {
      const pass = document.getElementById('loginPassword');
      pass.type = pass.type === 'password' ? 'text' : 'password';
    }
  </script>
</body>
</html>
