<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - FastDate.in | Create Your Dating Profile</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            lime: {
              300: '#bef264',
              400: '#a3e635',
              450: '#9ef01a',
              500: '#84cc16',
              600: '#65a30d',
              50: '#f7fee7'
            }
          },
          boxShadow: {
            'glow-lime': '0 0 30px -5px rgba(163, 230, 53, 0.4)',
          }
        }
      }
    }
  </script>

  <style>
    .wave-bg {
      background: radial-gradient(circle at 50% -20%, #bef264 0%, #a3e635 45%, #84cc16 85%, #65a30d 100%);
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">
  <!-- Main Registration Card Container -->
  <main class="flex-1 flex items-center justify-center p-0 md:p-6">
    <div class="w-full max-w-[430px] bg-white md:rounded-[40px] md:shadow-2xl overflow-hidden md:border md:border-slate-200/80 min-h-screen md:min-h-[820px] flex flex-col justify-between relative">
      
      <!-- Top Organic Wave Header with Back Button (Direct Reference to Screenshot Screen 3) -->
      <div class="relative w-full h-32 wave-bg shadow-sm flex items-center px-6 pt-4 overflow-hidden select-none">
        
        <!-- Subtle Wave Contours -->
        <svg class="absolute inset-0 w-full h-full opacity-20 pointer-events-none" viewBox="0 0 400 150" fill="none" stroke="#ffffff" stroke-width="1.6">
          <path d="M-20 30 Q 100 90, 220 20 T 420 60" />
          <path d="M-40 70 Q 90 130, 240 50 T 440 90" />
        </svg>

        <!-- Back Button to Login -->
        <a href="login.html" class="relative z-10 w-9 h-9 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow-sm transition-transform active:scale-90">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </a>

        <!-- Title -->
        <h1 class="relative z-10 text-lg font-extrabold text-slate-950 ml-4 tracking-tight">
          Finish signing up
        </h1>
      </div>

      <!-- Registration Form Body -->
      <div class="px-7 py-5 -mt-4 bg-white rounded-t-[32px] flex-1 flex flex-col justify-between relative z-20">
        
        <form onsubmit="event.preventDefault(); window.location.href='index.html';" class="space-y-3.5">
          
          <!-- Identity Trust Banner -->
          <div class="flex items-center gap-2.5 p-2.5 rounded-2xl bg-lime-50 border border-lime-200">
            <svg class="w-4 h-4 text-lime-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <p class="text-[11px] text-lime-900 font-semibold leading-tight">
              100% ID Verified singles. Real name on Govt ID ensures safety.
            </p>
          </div>

          <!-- First Name on ID -->
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">First name on ID</label>
            <input type="text" placeholder="e.g. James" value="James" required class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-sm font-semibold text-slate-900 bg-slate-50/50 outline-none focus:bg-white focus:border-lime-500 focus:ring-2 focus:ring-lime-400/20">
          </div>

          <!-- Last Name on ID -->
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">Last name on ID</label>
            <input type="text" placeholder="e.g. Anderson" value="Anderson" required class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-sm font-semibold text-slate-900 bg-slate-50/50 outline-none focus:bg-white focus:border-lime-500 focus:ring-2 focus:ring-lime-400/20">
          </div>

          <!-- Email -->
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">Email</label>
            <input type="email" placeholder="james.anderson92@gmail.com" value="james.anderson92@gmail.com" required class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-sm font-semibold text-slate-900 bg-slate-50/50 outline-none focus:bg-white focus:border-lime-500 focus:ring-2 focus:ring-lime-400/20">
          </div>

          <!-- Date of Birth -->
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">Date of birth</label>
            <input type="text" placeholder="DD/MM/YYYY" value="15/05/1998" required class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-sm font-semibold text-slate-900 bg-slate-50/50 outline-none focus:bg-white focus:border-lime-500 focus:ring-2 focus:ring-lime-400/20">
          </div>

          <!-- Gender & Dating Intentions -->
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">Dating Intention</label>
            <div class="grid grid-cols-3 gap-1.5 text-xs">
              <label class="cursor-pointer">
                <input type="radio" name="intention" class="peer hidden" checked>
                <div class="py-2 text-center rounded-xl bg-slate-100 text-slate-700 font-bold peer-checked:bg-lime-400 peer-checked:text-slate-950 transition-all border border-transparent peer-checked:border-lime-500 shadow-sm">
                  ⚡ 3m Date
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="intention" class="peer hidden">
                <div class="py-2 text-center rounded-xl bg-slate-100 text-slate-700 font-bold peer-checked:bg-lime-400 peer-checked:text-slate-950 transition-all border border-transparent peer-checked:border-lime-500 shadow-sm">
                  ☕ Coffee
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="intention" class="peer hidden">
                <div class="py-2 text-center rounded-xl bg-slate-100 text-slate-700 font-bold peer-checked:bg-lime-400 peer-checked:text-slate-950 transition-all border border-transparent peer-checked:border-lime-500 shadow-sm">
                  💍 Long-term
                </div>
              </label>
            </div>
          </div>

          <!-- Agreement Checkbox (matching screenshot) -->
          <div class="flex items-start gap-2.5 pt-1">
            <input type="checkbox" id="termsCheck" checked required class="mt-0.5 rounded text-lime-500 focus:ring-lime-400 h-4 w-4 border-slate-300">
            <label for="termsCheck" class="text-xs text-slate-500 leading-tight cursor-pointer">
              I read and agreed to <a href="#" class="text-slate-900 font-bold underline hover:text-lime-600">User Agreement</a> and <a href="#" class="text-slate-900 font-bold underline hover:text-lime-600">privacy policy</a>
            </label>
          </div>

          <!-- Primary Sign Up Button (Lime Green Pill) -->
          <div class="pt-2">
            <button type="submit" class="w-full py-4 rounded-2xl bg-lime-400 hover:bg-lime-500 text-slate-950 font-bold text-sm shadow-md shadow-lime-400/30 transition-all active:scale-[0.98]">
              Sign Up
            </button>
          </div>

          <!-- Divider -->
          <div class="relative flex py-2 items-center">
            <div class="flex-grow border-t border-slate-200"></div>
            <span class="flex-shrink mx-3 text-xs text-slate-400 uppercase tracking-wider font-bold">Or</span>
            <div class="flex-grow border-t border-slate-200"></div>
          </div>

          <!-- Social Quick Signups -->
          <div class="space-y-2">
            <!-- Google -->
            <button type="button" class="w-full py-3 px-4 rounded-2xl border border-slate-200 hover:border-slate-300 bg-white text-slate-700 font-bold text-xs flex items-center justify-center gap-3 transition-colors shadow-sm">
              <svg class="w-4 h-4" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              Continue with Google
            </button>

            <!-- Apple -->
            <button type="button" class="w-full py-3 px-4 rounded-2xl border border-slate-200 hover:border-slate-300 bg-white text-slate-900 font-bold text-xs flex items-center justify-center gap-3 transition-colors shadow-sm">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-1 .04-2.13.67-2.75 1.41-.54.63-.99 1.68-.89 2.69 1.1.09 2.03-.49 2.63-1.23z"/>
              </svg>
              Continue with Apple
            </button>
          </div>

        </form>

        <!-- Bottom Login Redirect -->
        <div class="pt-4 text-center">
          <p class="text-xs text-slate-500">
            Already have an account? 
            <a href="login.html" class="text-slate-950 font-bold underline hover:text-lime-600 transition-colors">
              Sign In
            </a>
          </p>
        </div>

      </div>

    </div>
  </main>

</body>
</html>
